# Use a managed PostgreSQL database such as Neon or Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Set the actual flat delivery charge in PKR. Use 0 only if delivery is free.
DELIVERY_CHARGE_PKR=

# Choose a long owner-only password. Never commit the real value.
ADMIN_PASSWORD=

# Generate a random secret with at least 32 characters. Never commit the real value.
SESSION_SECRET=
